function lessonOf(x){ if(x.cat.includes('6과')) return '6과'; if(x.cat.includes('7과')) return '7과'; if(x.cat.includes('8과')) return '8과'; if(['你家','没有','有几口人?','有几个哥哥?','多大了?','今年','属什么?','做','工作','你做什么工作?','你在哪儿工作?','汽车公司'].includes(x.c)) return '6과'; if(['怎么','晚','睡','昨天','几点','凌晨','两点','你吃饭了吗?','你几点吃饭?','我是凌晨两点才睡的。','干什么?','上网了吗?','玩儿在线游戏','聊天','起床','回家'].includes(x.c)) return '7과'; return '8과'; }
const Q=DATA.map((x,i)=>({...x,id:'q'+i,lesson:lessonOf(x),tokens:x.num.split(/\s+/).filter(Boolean).map((s,j)=>{let m=s.match(/([a-zA-ZüÜv:]+)([0-4])$/);return {raw:s,base:m?m[1]:s,tone:m?Number(m[2]):0,marked:(x.p.split(/\s+/)[j]||'')}})}));
const fillBlanks=[
{id:'f1',lesson:'6과',prompt:'你家____哥哥吗？',answer:'有',options:['有','在','是','做'],pinyin:'yǒu',korean:'있다'},
{id:'f2',lesson:'6과',prompt:'我____哥哥。',answer:'没有',options:['没有','不有','不是','不在'],pinyin:'méiyǒu',korean:'없다'},
{id:'f3',lesson:'6과',prompt:'你家有几____人？',answer:'口',options:['口','个','双','点'],pinyin:'kǒu',korean:'식구 수 양사'},
{id:'f4',lesson:'6과',prompt:'你____什么工作？',answer:'做',options:['做','在','有','睡'],pinyin:'zuò',korean:'하다'},
{id:'f5',lesson:'7과',prompt:'你吃饭____吗？',answer:'了',options:['了','的','才','在'],pinyin:'le',korean:'완료'},
{id:'f6',lesson:'7과',prompt:'我是凌晨两点____睡____。',answer:'才 / 的',options:['才 / 的','了 / 吗','在 / 的','有 / 了'],pinyin:'cái / de',korean:'비로소 / 강조'},
{id:'f7',lesson:'7과',prompt:'现在____点？',answer:'几',options:['几','哪','那','怎'],pinyin:'jǐ',korean:'몇'},
{id:'f8',lesson:'8과',prompt:'我____太喜欢逛街。',answer:'不',options:['不','没','有','在'],pinyin:'bú',korean:'그다지 ~않다'},
{id:'f9',lesson:'8과',prompt:'你想____什么？',answer:'买',options:['买','卖','睡','回'],pinyin:'mǎi',korean:'사다'},
{id:'f10',lesson:'8과',prompt:'____有很多商店。',answer:'那儿',options:['那儿','哪儿','什么','几'],pinyin:'nàr',korean:'거기'},
{id:'f11',lesson:'8과',prompt:'我想买____运动鞋。',answer:'一双',options:['一双','一个','一口','一点'],pinyin:'yì shuāng',korean:'한 켤레'},
{id:'f12',lesson:'8과',prompt:'你____去哪儿？',answer:'打算',options:['打算','喜欢','还有','凌晨'],pinyin:'dǎsuan',korean:'계획하다'}];
const writingChars=[...new Set(DATA.map(x=>x.c.replace(/[?？。,.， ]/g,'')).join('').split('').filter(ch=>/[一-鿿]/.test(ch)))].map((ch,i)=>{let found=DATA.find(x=>x.c.includes(ch));return {id:'w'+i,lesson:found?lessonOf(found):'전체',char:ch,pinyin:found?found.p:'',meaning:found?found.m:''}});
function saveProgress(){localStorage.setItem('china-final-6-8-progress',JSON.stringify(state.progress))}function normalize(t){return (t||'').toLowerCase().replace(/[?？。.,，\s]/g,'').trim()}function byLesson(list){return list.filter(x=>state.lesson==='전체'||x.lesson===state.lesson)}function searchFilter(list,fields){let k=normalize(state.search);if(!k)return list;return list.filter(x=>normalize(fields(x).join(' ')).includes(k))}
function renderTabs(){lessonTabs.innerHTML=lessons.map(l=>`<button class="${state.lesson===l?'active':''}" data-lesson="${l}">${l}</button>`).join('');categoryTabs.innerHTML=categories.map(c=>`<button class="${state.category===c.key?'active':''}" data-category="${c.key}">${c.label}</button>`).join('');modeTabs.innerHTML=modes.map(m=>`<button class="${state.mode===m.key?'active':''}" data-mode="${m.key}">${m.label}</button>`).join('');lessonTabs.querySelectorAll('button').forEach(b=>b.onclick=()=>{state.lesson=b.dataset.lesson;render()});categoryTabs.querySelectorAll('button').forEach(b=>b.onclick=()=>{state.category=b.dataset.category;render()});modeTabs.querySelectorAll('button').forEach(b=>b.onclick=()=>{state.mode=b.dataset.mode;render()});modeTabs.classList.toggle('hidden',state.category!=='quiz');document.getElementById('wrongOnlyBtn').classList.toggle('hidden',state.category!=='quiz'&&state.category!=='fill');}
function filteredQuiz(){let list=byLesson(Q);if(state.wrongOnly)list=list.filter(q=>state.progress[q.id]==='wrong');list=searchFilter(list,x=>[x.c,x.p,x.num,x.m,x.note||'',x.cat]);if(state.order==='random')list=[...list].sort(()=>Math.random()-.5);return list}
function filteredFill(){let list=byLesson(fillBlanks);if(state.wrongOnly)list=list.filter(q=>state.progress[q.id]==='wrong');list=searchFilter(list,x=>[x.prompt,x.answer,x.pinyin,x.korean,...x.options]);if(state.order==='random')list=[...list].sort(()=>Math.random()-.5);return list}
function toneButtons(id,idx){return [0,1,2,3,4].map(n=>`<button class="tone-btn" data-card="${id}" data-token="${idx}" data-tone="${n}">${n===0?'0(경)':n}</button>`).join('')}
function renderQuizCards(){let list=filteredQuiz();mainTitle.textContent=`${state.lesson} · ${modes.find(m=>m.key===state.mode).label}`; if(!list.length)return false; quizList.innerHTML=list.map(q=>{let prompt=state.mode==='tone'?q.c:state.mode==='meaning'?q.c:state.mode==='hanzi'?q.m:q.p;let answer=state.mode==='tone'?q.num:state.mode==='meaning'?q.m:state.mode==='hanzi'?q.c:q.c;let progress=state.progress[q.id];return `<article class="quiz-card" data-id="${q.id}"><div class="quiz-head"><div><div class="hanzi">${prompt}</div><div class="meaning">${q.cat} · ${q.m}</div><div class="badge-row"><span class="badge">${q.lesson}</span><span class="badge">정답: ${state.mode==='tone'?'성조 숫자':state.mode==='meaning'?'뜻':state.mode==='hanzi'?'중국어':'중국어'}</span>${progress==='correct'?'<span class="badge">최근 정답 ✅</span>':''}${progress==='wrong'?'<span class="badge">최근 오답 ❌</span>':''}</div></div></div>${state.mode==='tone'?`<div class="tokens">${q.tokens.map((t,i)=>`<div class="token-row"><div class="token-top"><div class="token-hanzi">${t.marked||t.raw}</div><div class="token-base">${t.base}</div></div><div class="tone-buttons">${toneButtons(q.id,i)}</div></div>`).join('')}</div>`:`<input class="answerInput" data-answer="${answer.replaceAll('"','&quot;')}" placeholder="정답 입력" type="text" style="width:100%;margin-top:14px;border-radius:18px;padding:14px">`}<div class="check-row" style="margin-top:16px"><button class="primary check-btn" data-check="${q.id}">제출</button><button class="secondary reveal-btn" data-reveal="${q.id}">정답 보기</button><button class="secondary reset-btn">초기화</button></div><div class="result" id="result-${q.id}"></div><template class="answerData">${JSON.stringify({c:q.c,p:q.p,num:q.num,m:q.m,note:q.note||'',answer})}</template></article>`}).join('');
quizList.querySelectorAll('.tone-btn').forEach(btn=>btn.onclick=()=>{let card=btn.closest('.quiz-card'),token=btn.dataset.token;card.querySelectorAll(`.tone-btn[data-token="${token}"]`).forEach(b=>b.classList.remove('selected'));btn.classList.add('selected')});
quizList.querySelectorAll('.check-btn').forEach(btn=>btn.onclick=()=>{let card=btn.closest('.quiz-card'),q=list.find(x=>x.id===btn.dataset.check),res=document.getElementById('result-'+q.id);let ok=false;if(state.mode==='tone'){let answers=q.tokens.map((_,i)=>{let s=card.querySelector(`.tone-btn.selected[data-token="${i}"]`);return s?Number(s.dataset.tone):null});if(answers.includes(null)){res.className='result bad';res.innerHTML='아직 안 고른 음절이 있어 👀';return}ok=answers.every((v,i)=>v===q.tokens[i].tone);res.className='result '+(ok?'good':'bad');res.innerHTML=(ok?'맞았어! ✅':'틀렸어! ❌')+`<div class="answer-big">(${q.p})</div><div class="number-pinyin">숫자병음: ${q.num}</div><div class="hint">${q.m}<br>${q.note||''}</div>`}else{let input=card.querySelector('.answerInput').value;let answer=card.querySelector('.answerInput').dataset.answer;ok=normalize(input)===normalize(answer);res.className='result '+(ok?'good':'bad');res.innerHTML=(ok?'맞았어! ✅':'다시 체크! ❌')+`<div class="answer-big">${q.c}</div><div class="number-pinyin">${q.p} / ${q.num}</div><div class="hint">정답: ${answer}<br>${q.m}<br>${q.note||''}</div>`}state.progress[q.id]=ok?'correct':'wrong';saveProgress();renderStats();});
quizList.querySelectorAll('.reveal-btn').forEach(btn=>btn.onclick=()=>{let q=list.find(x=>x.id===btn.dataset.reveal),res=document.getElementById('result-'+q.id);res.className='result good';let answer=state.mode==='tone'?q.num:state.mode==='meaning'?q.m:state.mode==='hanzi'?q.c:q.c;res.innerHTML=`정답 보기 👀<div class="answer-big">${answer}</div><div class="number-pinyin">${q.p} / ${q.num}</div><div class="hint">${q.m}<br>${q.note||''}</div>`});quizList.querySelectorAll('.reset-btn').forEach(btn=>btn.onclick=()=>{let card=btn.closest('.quiz-card');card.querySelectorAll('.tone-btn').forEach(b=>b.classList.remove('selected'));let i=card.querySelector('.answerInput');if(i)i.value='';let r=card.querySelector('.result');r.className='result';r.innerHTML=''});return true;}
function renderFillCards(){let list=filteredFill();mainTitle.textContent=`${state.lesson} · 빈칸/뜻 퀴즈`;if(!list.length)return false;fillList.innerHTML=list.map(item=>`<article class="fill-card" data-fill-id="${item.id}"><div class="fill-head"><div><div class="text-title">${item.prompt.replace(/____/g,'<span class="blank"></span>')}</div><div class="meaning">${item.korean}</div><div class="badge-row"><span class="badge">${item.lesson}</span><span class="badge">빈칸</span>${state.progress[item.id]==='wrong'?'<span class="badge">최근 오답 ❌</span>':''}</div></div></div><div class="fill-options">${item.options.map(o=>`<button class="fill-option" data-value="${o}">${o}</button>`).join('')}</div><div class="fill-actions" style="margin-top:16px"><button class="primary fill-check" data-id="${item.id}">정답 확인</button><button class="secondary fill-reveal" data-id="${item.id}">답 보기</button></div><div class="fill-result" id="fill-result-${item.id}"></div></article>`).join('');fillList.querySelectorAll('.fill-option').forEach(b=>b.onclick=()=>{let card=b.closest('.fill-card');card.querySelectorAll('.fill-option').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});fillList.querySelectorAll('.fill-check').forEach(b=>b.onclick=()=>{let item=list.find(x=>x.id===b.dataset.id),card=b.closest('.fill-card'),sel=card.querySelector('.fill-option.selected'),res=document.getElementById('fill-result-'+item.id);if(!sel){res.className='fill-result bad';res.innerHTML='보기 하나를 먼저 골라줘 👀';return}let ok=sel.dataset.value===item.answer;state.progress[item.id]=ok?'correct':'wrong';saveProgress();renderStats();res.className='fill-result '+(ok?'good':'bad');res.innerHTML=(ok?'맞았어! ✅':'틀렸어! ❌')+`<div class="answer-big">${item.answer}</div><div class="hint">병음: ${item.pinyin}<br>뜻: ${item.korean}</div>`});fillList.querySelectorAll('.fill-reveal').forEach(b=>b.onclick=()=>{let item=list.find(x=>x.id===b.dataset.id),res=document.getElementById('fill-result-'+item.id);res.className='fill-result good';res.innerHTML=`정답 보기 👀<div class="answer-big">${item.answer}</div><div class="hint">병음: ${item.pinyin}<br>뜻: ${item.korean}</div>`});return true;}
function renderTable(){let list=byLesson(Q);list=searchFilter(list,x=>[x.c,x.p,x.num,x.m,x.note||'',x.cat]);mainTitle.textContent=`${state.lesson} · 총망라표`;if(!list.length)return false;tableList.innerHTML=`<div class="table-card"><div class="table-wrap"><table><thead><tr><th>중국어</th><th>병음</th><th>성조 숫자</th><th>뜻/함정</th></tr></thead><tbody>${list.map(x=>`<tr><td class="hanzi">${x.c}</td><td class="pin">${x.p}</td><td class="num">${x.num}</td><td>${x.m}<br><span class="small">${x.note||''}</span></td></tr>`).join('')}</tbody></table></div></div>`;return true;}
function renderGrammar(){mainTitle.textContent='문법 함정 · 시험 직전';grammarList.innerHTML=`<div class="grammar-grid"><div class="grammar-card"><h3>1️⃣ 了 le</h3><div class="rule"><b>你吃饭了吗?</b><br>밥 먹었나요? → 완료 확인</div><div class="rule"><b>多大了?</b><br>몇 살이 되었나요? → 변화</div><div class="rule red">부정 완료는 보통 没 + 동사: 我没吃饭。</div></div><div class="grammar-card"><h3>2️⃣ 是~的 + 才</h3><div class="rule"><b>我是凌晨两点才睡的。</b><br>새벽 2시에야 잤다. 시간 강조</div><div class="rule"><b>才</b> = 비로소, 겨우</div></div><div class="grammar-card"><h3>3️⃣ 做 / 工作</h3><div class="rule"><b>做</b> = 하다</div><div class="rule"><b>工作</b> = 일 / 일하다 / 직업</div><div class="rule"><b>你做什么工作?</b> = 무슨 일을 하나요?</div></div><div class="grammar-card"><h3>4️⃣ 在 / 有</h3><div class="rule"><b>你在哪儿工作?</b><br>在 + 장소 + 동사</div><div class="rule"><b>那儿有很多商店。</b><br>장소 + 有 + 사물</div></div><div class="grammar-card"><h3>5️⃣ 哪儿 / 那儿</h3><div class="rule"><b>哪儿</b> = 어디?</div><div class="rule"><b>那儿</b> = 거기/저기</div></div><div class="grammar-card"><h3>6️⃣ 양사</h3><div class="rule">几<b>口</b>人 = 식구 수</div><div class="rule">几<b>个</b>哥哥 = 형/오빠 몇 명</div><div class="rule">一<b>双</b>运动鞋 = 운동화 한 켤레</div></div></div>`;return true;}
function filteredWriting(){let list=byLesson(writingChars);return searchFilter(list,x=>[x.char,x.pinyin,x.meaning])}
function renderWriting(){let list=filteredWriting();mainTitle.textContent=`${state.lesson} · 한자 쓰기`;if(!list.length)return false;writingList.innerHTML=list.map(item=>`<article class="writing-card"><div class="writing-head"><div><div class="writing-char">${item.char}</div><div class="writing-meaning">${item.meaning}</div><div class="badge-row"><span class="badge">${item.lesson}</span><span class="badge">${item.pinyin}</span></div></div></div><div class="stroke-sheet"><div class="trace-box"><span>${item.char}</span></div><div class="trace-box"><span>${item.char}</span></div></div><div class="check-row" style="margin-top:14px"><button class="primary set-paint-target" data-char="${item.char}">그림판에 띄우기</button></div></article>`).join('');paintCard.innerHTML=`<div class="writing-head"><div><div class="text-title">간이 화이트보드 ✏️</div><div class="small">선택한 한자를 보고 직접 써보는 칸이야. 가운데 선에 맞춰 크게 써봐.</div><div class="badge-row"><span class="badge">현재 글자</span><span class="badge paint-target" id="paintTargetLabel">${state.paintTarget}</span></div></div></div><div class="paint-tools"><button class="secondary" id="clearCanvasBtn">지우기</button><label class="small">굵기 <input id="brushRange" type="range" min="2" max="20" value="${state.brushSize}"></label></div><div class="paint-canvas-wrap"><canvas id="writingCanvas" width="900" height="540"></canvas></div>`;writingList.querySelectorAll('.set-paint-target').forEach(b=>b.onclick=()=>{state.paintTarget=b.dataset.char;renderWriting()});initCanvas();return true;}
function initCanvas(){let canvas=document.getElementById('writingCanvas');if(!canvas)return;let ctx=canvas.getContext('2d'),drawing=false;function guide(){ctx.clearRect(0,0,canvas.width,canvas.height);ctx.save();ctx.font='220px "Noto Sans SC", "Microsoft YaHei", sans-serif';ctx.fillStyle='rgba(99,185,127,.14)';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(state.paintTarget,canvas.width/2,canvas.height/2);ctx.restore()}function pos(e){let r=canvas.getBoundingClientRect(),p=e.touches?e.touches[0]:e;return {x:(p.clientX-r.left)*(canvas.width/r.width),y:(p.clientY-r.top)*(canvas.height/r.height)}}ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle='#1d6f43';ctx.lineWidth=state.brushSize;guide();canvas.onmousedown=e=>{drawing=true;let p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y)};canvas.onmousemove=e=>{if(!drawing)return;e.preventDefault();let p=pos(e);ctx.lineWidth=state.brushSize;ctx.lineTo(p.x,p.y);ctx.stroke()};window.onmouseup=()=>{drawing=false;ctx.beginPath()};canvas.ontouchstart=canvas.onmousedown;canvas.ontouchmove=canvas.onmousemove;canvas.ontouchend=window.onmouseup;document.getElementById('clearCanvasBtn').onclick=guide;document.getElementById('brushRange').oninput=e=>{state.brushSize=Number(e.target.value)};}
function showSection(){['quiz','fill','table','grammar','writing'].forEach(s=>document.getElementById(s+'Section').classList.toggle('hidden',state.category!==s))}
function renderStats(){let vals=Object.values(state.progress);totalCount.textContent=Q.length+fillBlanks.length;correctCount.textContent=vals.filter(v=>v==='correct').length;wrongCount.textContent=vals.filter(v=>v==='wrong').length}
function renderCurrent(){showSection();quizList.innerHTML='';fillList.innerHTML='';tableList.innerHTML='';grammarList.innerHTML='';writingList.innerHTML='';paintCard.innerHTML='';let has=false;if(state.category==='quiz')has=renderQuizCards();if(state.category==='fill')has=renderFillCards();if(state.category==='table')has=renderTable();if(state.category==='grammar')has=renderGrammar();if(state.category==='writing')has=renderWriting();emptyState.style.display=has?'none':'block'}
function render(){renderTabs();renderCurrent();renderStats();document.getElementById('wrongOnlyBtn').classList.toggle('active',state.wrongOnly);document.getElementById('shuffleBtn').classList.toggle('active',state.order==='random')}
searchInput.oninput=e=>{state.search=e.target.value;render()};document.getElementById('shuffleBtn').onclick=()=>{state.order=state.order==='random'?'default':'random';render()};document.getElementById('wrongOnlyBtn').onclick=()=>{state.wrongOnly=!state.wrongOnly;render()};document.getElementById('resetProgressBtn').onclick=()=>{state.progress={};saveProgress();render()};render();
</script>
</body></html>
